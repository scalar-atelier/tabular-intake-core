{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scalar-inc.com/contracts/table-cleanup-profile.v1.schema.json",
  "title": "TableCleanupProfileV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "columns", "keyColumns", "blankValues", "maxRows", "maxCellChars"],
  "properties": {
    "schemaVersion": { "const": "scalar-table-cleanup-profile/v1" },
    "columns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "output", "transform", "required"],
        "properties": {
          "source": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\u0000\\r\\n]+$" },
          "output": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\u0000\\r\\n]+$" },
          "transform": { "enum": ["text", "date_ymd", "number", "phone_kr", "enum"] },
          "required": { "type": "boolean" },
          "enumMap": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 100,
            "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 200 }
          }
        }
      }
    },
    "keyColumns": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "blankValues": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "string", "maxLength": 200 }
    },
    "maxRows": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "maxCellChars": { "type": "integer", "minimum": 1, "maximum": 50000 }
  }
}
